---
import { footerShop, footerCompany, footerSupport, footerLegal, socials, site } from '../data/site';

const columns = [
  { title: 'Shop', links: footerShop },
  { title: 'Company', links: footerCompany },
  { title: 'Support', links: footerSupport },
  { title: 'Legal', links: footerLegal },
];
---
<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr_1fr]">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Join the listening list.</h2>
        <p class="mt-2 max-w-[300px] text-sm leading-relaxed text-grey">New drops, listening guides and members-only offers. One email a month — no spam, ever.</p>
        <form id="newsletter-form" class="mt-4 flex max-w-[340px] items-center gap-2 rounded-full bg-white p-1.5 ring-1 ring-black/5 focus-within:ring-ink/30">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" required placeholder="you@example.com" class="w-full min-w-0 bg-transparent px-3 text-sm outline-none placeholder:text-grey" />
          <button type="submit" class="shrink-0 rounded-full bg-ink px-4 py-2.5 text-[13px] font-medium text-white transition hover:bg-ink-soft">Subscribe</button>
        </form>
        <p class="mt-2 text-[11px] text-grey">Mock demo — no emails are sent or stored.</p>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h3 class="text-[11px] font-semibold uppercase tracking-wider text-ink">{col.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {col.links.map((item) => (
              <li><a href={item.href} class="text-sm text-grey transition hover:text-ink">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-line pt-6 md:flex-row">
      <div class="flex items-center gap-5" aria-label="Social links">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="text-ink transition hover:text-grey">
            {s.label === 'X' && <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L1.5 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7 3.7H5.2L17.8 20Z"/></svg>}
            {s.label === 'Instagram' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"/></svg>}
            {s.label === 'YouTube' && <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.8-.5-5.5c-.3-1-1-1.7-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5c-1 .3-1.7 1-2 2C1 8.2 1 12 1 12s0 3.8.5 5.5c.3 1 1 1.7 2 2 1.7.5 8.5.5 8.5.5s6.8 0 8.5-.5c1-.3 1.7-1 2-2 .5-1.7.5-5.5.5-5.5ZM9.8 15.5v-7l6 3.5-6 3.5Z"/></svg>}
          </a>
        ))}
      </div>
      <p class="text-center text-[11px] leading-relaxed text-grey">© {site.year} {site.name}. All rights reserved. · Demo store — products, prices and orders are mock data.</p>
    </div>
  </div>
  <div id="toast" role="status" aria-live="polite" class="fixed bottom-5 left-1/2 z-[96] max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-full bg-ink px-5 py-3 text-center text-sm font-medium text-white opacity-0 transition-opacity duration-300 pointer-events-none [&.show]:opacity-100"></div>
</footer>
