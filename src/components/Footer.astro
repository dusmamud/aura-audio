---
import { footerLinks, legalLinks, socials, site } from '../data/site';
---
<footer id="support" class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-6 sm:px-6 md:flex-row md:justify-between">
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2" aria-label="Footer">
      {footerLinks.map((item) => (
        <a href={item.href} class="text-[11px] font-medium uppercase tracking-wider text-grey transition hover:text-ink">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-5" aria-label="Social links">
      {socials.map((s) => (
        <a href={s.href} aria-label={s.label} class="text-ink transition hover:text-grey">
          {s.label === 'X' && <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L1.5 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7 3.7H5.2L17.8 20Z"/></svg>}
          {s.label === 'Instagram' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"/></svg>}
          {s.label === 'YouTube' && <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.8-.5-5.5c-.3-1-1-1.7-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5c-1 .3-1.7 1-2 2C1 8.2 1 12 1 12s0 3.8.5 5.5c.3 1 1 1.7 2 2 1.7.5 8.5.5 8.5.5s6.8 0 8.5-.5c1-.3 1.7-1 2-2 .5-1.7.5-5.5.5-5.5ZM9.8 15.5v-7l6 3.5-6 3.5Z"/></svg>}
        </a>
      ))}
    </div>
    <nav class="flex items-center gap-6" aria-label="Legal">
      {legalLinks.map((item) => (
        <a href={item.href} class="text-[11px] font-medium uppercase tracking-wider text-grey transition hover:text-ink">{item.label}</a>
      ))}
    </nav>
  </div>
  <p class="pb-6 text-center text-[11px] text-grey">© {site.year} {site.name}. All rights reserved.</p>
  <div id="toast" role="status" aria-live="polite" class="fixed bottom-5 left-1/2 z-[96] max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-full bg-ink px-5 py-3 text-center text-sm font-medium text-white opacity-0 transition-opacity duration-300 pointer-events-none [&.show]:opacity-100"></div>
</footer>
