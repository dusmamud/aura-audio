---
/**
 * Cookie consent banner — mock, localStorage only. Hidden by default;
 * motion.ts shows it when no `aura-consent` choice is stored yet.
 * Fixed at the bottom; it never shifts layout. On mobile PDPs the
 * sticky buy bar hides it while the bar is visible (motion.ts).
 */
---
<div
  id="cookie-banner"
  data-pending="0"
  class="fixed inset-x-0 bottom-0 z-[80] hidden border-t border-line bg-white/95 backdrop-blur-md"
  role="region"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="text-xs leading-relaxed text-ink-soft">
      We use cookies to remember your bag, wishlist and demo preferences. No tracking, no ads — this is a demo
      store. <a href="/privacy/" class="font-medium text-ink underline underline-offset-2">Privacy policy</a>
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-consent="declined"
        class="min-h-11 rounded-full px-5 py-2.5 text-[13px] font-medium ring-1 ring-black/10 transition hover:ring-ink"
      >
        Decline
      </button>
      <button
        type="button"
        data-consent="accepted"
        class="min-h-11 rounded-full bg-ink px-5 py-2.5 text-[13px] font-medium text-white transition hover:bg-ink-soft"
      >
        Accept
      </button>
    </div>
  </div>
</div>
