---
import Picture from './Picture.astro';
import Stars from './Stars.astro';
import { formatPrice, type Product } from '../data/site';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
---
<article class="product-card flex flex-col rounded-2xl bg-card p-3 sm:p-4">
  <div class="relative overflow-hidden rounded-xl bg-card">
    <a href={`/products/${p.slug}/`} aria-label={p.name}>
      <Picture
        name={p.img}
        alt={p.alt}
        widths={[640, 800]}
        sizes="(max-width: 768px) 50vw, 280px"
        ratio="aspect-square"
      />
    </a>
    {p.badge && (
      <span class="absolute left-2 top-2 rounded-full bg-white px-2.5 py-1 text-[11px] font-medium text-ink">
        {p.badge}
      </span>
    )}
    <button
      type="button"
      data-wishlist-toggle={p.slug}
      aria-pressed="false"
      aria-label={`Save ${p.name} to wishlist`}
      class="absolute right-2 top-2 grid h-9 w-9 place-items-center rounded-full bg-white/90 ring-1 ring-black/5 transition hover:scale-105"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
    </button>
  </div>
  <h3 class="mt-3 text-sm font-medium">
    <a href={`/products/${p.slug}/`} class="transition hover:underline">{p.name}</a>
  </h3>
  <p class="mt-0.5 text-xs text-grey">{p.tagline}</p>
  <div class="mt-2">
    <Stars rating={p.rating} reviewsCount={p.reviewsCount} showCount />
  </div>
  <p class="mt-2 text-sm font-medium">
    {formatPrice(p.price)}
    {p.compareAt && (
      <span class="ml-2 font-normal text-grey line-through">{formatPrice(p.compareAt)}</span>
    )}
  </p>
  <button
    type="button"
    data-add-to-bag={p.slug}
    class="mt-3 w-full rounded-full bg-ink py-2.5 text-[13px] font-medium text-white transition hover:bg-ink-soft"
  >
    Add to bag
  </button>
</article>
