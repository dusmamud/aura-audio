---
/** Back-to-top button — visibility and scrolling are wired in motion.ts. */
---
<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed bottom-5 right-5 z-40 grid h-11 w-11 translate-y-3 place-items-center rounded-full bg-ink text-white opacity-0 shadow-lg transition-all duration-300 pointer-events-none hover:bg-ink-soft [&.show]:translate-y-0 [&.show]:opacity-100 [&.show]:pointer-events-auto"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
