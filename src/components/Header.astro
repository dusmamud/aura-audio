---
import { nav, site } from '../data/site';
---
<header class="fixed inset-x-0 top-0 z-50 bg-mist/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:h-16 sm:px-6">
    <a href="/" class="text-sm font-bold tracking-[0.25em] text-ink" aria-label={`${site.name} — home`}>{site.name}</a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class="text-[11px] font-medium uppercase tracking-wider text-ink-soft transition hover:text-ink">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <button id="bag-btn" type="button" aria-label="Shopping bag" class="grid h-10 w-10 place-items-center rounded-full transition hover:bg-ink/5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 14H5L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      </button>
      <button id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="grid h-10 w-10 place-items-center rounded-full transition hover:bg-ink/5 md:hidden">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-line bg-mist px-4 pb-4 pt-2 md:hidden" aria-label="Mobile">
    {nav.map((item) => (
      <a href={item.href} class="block rounded-lg px-2 py-3 text-sm font-medium text-ink-soft hover:bg-ink/5 hover:text-ink">{item.label}</a>
    ))}
  </nav>
</header>
