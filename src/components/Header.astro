---
import { nav, site, announcements, products } from '../data/site';
import CartDrawer from './CartDrawer.astro';

// Search payload — read client-side by motion.ts, no extra fetch.
const searchData = products.map((p) => ({ slug: p.slug, name: p.name, price: p.price, img: p.img, category: p.category, rating: p.rating, keywords: p.keywords }));
---
<div class="fixed inset-x-0 top-0 z-50">
  <div class="bg-ink text-center text-[11px] font-medium tracking-wide text-white">
    <p class="px-4 py-2"><span id="announcement-text" data-messages={JSON.stringify(announcements)} class="transition-opacity duration-500">{announcements[0]}</span></p>
  </div>
  <header class="bg-mist/85 backdrop-blur-md">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:h-16 sm:px-6">
      <a href="/" class="text-sm font-bold tracking-[0.25em] text-ink" aria-label={`${site.name} — home`}>{site.name}</a>
      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} class="text-[11px] font-medium uppercase tracking-wider text-ink-soft transition hover:text-ink">{item.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-1">
        <button id="search-btn" type="button" aria-label="Search products" class="grid h-11 w-11 place-items-center rounded-full transition hover:bg-ink/5">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
        </button>
        <a href="/wishlist/" aria-label="Wishlist" class="relative grid h-11 w-11 place-items-center rounded-full transition hover:bg-ink/5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
          <span id="wishlist-count" class="absolute right-0 top-0 hidden h-4 min-w-4 place-items-center rounded-full bg-ink px-1 text-[10px] font-semibold leading-none text-white">0</span>
        </a>
        <button id="bag-btn" type="button" aria-label="Shopping bag" class="relative grid h-11 w-11 place-items-center rounded-full transition hover:bg-ink/5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 14H5L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span id="bag-count" class="absolute right-0 top-0 hidden h-4 min-w-4 place-items-center rounded-full bg-ink px-1 text-[10px] font-semibold leading-none text-white">0</span>
        </button>
        <button id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="grid h-11 w-11 place-items-center rounded-full transition hover:bg-ink/5 md:hidden">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="hidden border-t border-line bg-mist px-4 pb-4 pt-2 md:hidden" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} class="block rounded-lg px-2 py-3 text-sm font-medium text-ink-soft hover:bg-ink/5 hover:text-ink">{item.label}</a>
      ))}
    </nav>
  </header>
</div>

<!-- Search overlay -->
<div id="search-overlay" class="fixed inset-0 z-[92] hidden bg-mist/95 backdrop-blur-md" role="dialog" aria-modal="true" aria-label="Search products">
  <div class="mx-auto max-w-2xl px-4 pt-28 sm:pt-32">
    <div id="search-panel" class="flex items-center gap-3 border-b border-ink pb-3">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="shrink-0 text-grey" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
      <input id="search-input" type="search" placeholder="Search headphones, earbuds, speakers…" autocomplete="off" class="w-full bg-transparent text-xl font-medium outline-none placeholder:text-grey" />
      <button type="button" data-close-search aria-label="Close search" class="grid h-11 w-11 shrink-0 place-items-center rounded-full transition hover:bg-ink/5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p id="search-label" class="mt-5 text-[11px] font-medium uppercase tracking-wider text-grey">Popular right now</p>
    <ul id="search-results" class="mt-1 divide-y divide-line"></ul>
    <p id="search-empty" class="mt-6 hidden text-sm text-grey">No products match that search. Try “headphones” or “buds”.</p>
  </div>
</div>

<CartDrawer />
<script type="application/json" id="search-data" set:html={JSON.stringify(searchData)} />
