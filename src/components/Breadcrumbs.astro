---
/** Breadcrumb trail. Last item is the current page (no link). */
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6 sm:pt-28">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-grey">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="transition hover:text-ink">{item.label}</a>
        ) : (
          <span aria-current="page" class="font-medium text-ink">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
