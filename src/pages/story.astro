---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const values = [
  {
    title: 'Craft',
    body: 'Fewer products, done properly. We would rather make one headphone well than ten headphones adequately.',
  },
  {
    title: 'Honesty',
    body: 'Mock-free specs: if we print a number, we measured it. No inflated battery claims, no borrowed test results.',
  },
  {
    title: 'Longevity',
    body: 'Built to be repaired, not replaced. Spare ear cushions, replaceable cables, and a two-year warranty on every product.',
  },
];

const timeline = [
  { year: '2023', title: 'Founded in Mumbai', body: 'Two engineers, one workbench, and a shared frustration: headphones had become jewellery with speakers attached.' },
  { year: '2024', title: 'AURA One launches', body: 'Our first product — the flagship over-ear headphone with beryllium drivers and adaptive noise cancelling.' },
  { year: '2025', title: 'Buds Pro and AURA Home', body: 'The range grows: pocket-sized studio sound with Buds Pro, and room-filling sound with AURA Home.' },
  { year: '2026', title: 'Smart Watch and worldwide shipping', body: 'AURA Watch joins the family, and AURA ships to customers around the world.' },
];
---
<Layout
  title="Our Story — AURA"
  description="AURA was founded in 2023 in Mumbai by two engineers who thought headphones had become jewellery with speakers attached. Fewer products, done properly."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Our Story' }]} />

  <!-- HERO -->
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10" aria-labelledby="story-heading">
    <div class="reveal">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-grey">Our Story</p>
      <h1 id="story-heading" class="mt-4 max-w-2xl text-4xl font-medium leading-[1.05] tracking-[-0.03em] sm:text-6xl">
        Sound, distilled to what matters.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-grey">
        AURA was founded in 2023 in Mumbai by two engineers who thought headphones
        had become jewellery with speakers attached — beautiful objects that
        happened to play music, instead of instruments built for listening.
      </p>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-grey">
        The idea was simple, and it has not changed since: make one product,
        done properly. No endless range, no yearly refresh for its own sake,
        no feature added to fill a box. Just careful engineering, honest
        materials, and sound that respects the recording.
      </p>
    </div>
  </section>

  <!-- VALUES -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="values-heading">
    <h2 id="values-heading" class="sr-only">What we believe</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {values.map((v) => (
        <article class="reveal rounded-2xl bg-card p-6 sm:p-8">
          <h3 class="text-lg font-semibold tracking-tight">{v.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-grey">{v.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="timeline-heading">
    <div class="reveal">
      <h2 id="timeline-heading" class="text-2xl font-semibold tracking-tight">2023 – 2026</h2>
      <ol class="mt-8 space-y-0">
        {timeline.map((t, i) => (
          <li class={`relative flex gap-6 pb-8 ${i < timeline.length - 1 ? 'border-l border-black/10 pl-0' : ''}`}>
            <div class="flex flex-col items-start gap-1 pl-6">
              <p class="text-2xl font-light tracking-tight">{t.year}</p>
              <h3 class="text-base font-semibold tracking-tight">{t.title}</h3>
              <p class="max-w-xl text-sm leading-relaxed text-grey">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CRAFTSMANSHIP -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="craft-heading">
    <div class="reveal grid items-center gap-6 md:grid-cols-2 md:gap-10">
      <div>
        <div class="overflow-hidden rounded-2xl bg-card">
          <Picture
            name="lifestyle-desk"
            alt="AURA headphones resting on a light desk next to their fabric carrying case"
            sizes="(max-width: 768px) 100vw, 560px"
            ratio="aspect-[16/10]"
          />
        </div>
      </div>
      <div>
        <h2 id="craft-heading" class="text-2xl font-semibold leading-snug tracking-tight">Made to be kept.</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-grey">
          Brushed aluminium, breathable acoustic fabric, memory foam that keeps
          its shape — the materials are chosen to age well, not just to look
          good in a photograph. Every AURA product is covered by a 2-year
          warranty, and spare parts are made to be replaced rather than thrown away.
        </p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-grey">
          A headphone you keep for years is better for you and better for the
          planet than one you replace every season. That is the whole idea.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-2 sm:px-6" aria-labelledby="cta-heading">
    <div class="reveal flex flex-col gap-6 rounded-[1.75rem] bg-[#ececea] px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10 sm:py-12">
      <div>
        <h2 id="cta-heading" class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">Sound that Inspires.<br />Design that Lasts.</h2>
        <p class="mt-2 text-sm text-grey">See what three years of doing one thing properly sounds like.</p>
      </div>
      <a href="/products/" class="inline-flex shrink-0 items-center gap-3 self-start rounded-full bg-white px-5 py-3 text-[13px] font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.06),0_8px_24px_rgba(0,0,0,0.06)] ring-1 ring-black/5 transition hover:bg-ink hover:text-white sm:self-auto">
        Shop AURA
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </a>
    </div>
  </section>
</Layout>
