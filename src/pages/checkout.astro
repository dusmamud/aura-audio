---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Layout
  title="Checkout — AURA"
  description="Demo checkout for AURA. No real payment is processed and no order is fulfilled — this is a mock store."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Checkout' }]} />

  <section class="mx-auto max-w-6xl px-4 pb-16 pt-6 sm:px-6" aria-labelledby="checkout-heading">
    <h1 id="checkout-heading" class="text-3xl font-semibold tracking-tight sm:text-4xl">Checkout</h1>
    <p class="mt-2 text-sm text-grey">Demo checkout — no payment is processed and nothing is shipped. Do not enter real card details.</p>

    <!-- Empty cart state -->
    <div id="checkout-empty" class="hidden py-16 text-center">
      <p class="text-lg font-medium">Your bag is empty.</p>
      <p class="mt-2 text-sm text-grey">Add something beautiful first — your checkout will appear here.</p>
      <a href="/products/" class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-white transition hover:bg-ink-soft">Shop products</a>
    </div>

    <!-- Success state -->
    <div id="checkout-success" class="hidden py-10 text-center">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-ink text-white">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h2 class="mt-5 text-2xl font-semibold tracking-tight">Order placed — thank you.</h2>
      <p class="mt-2 text-sm text-grey">Order number <span id="order-number" class="font-medium text-ink"></span></p>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-grey">This is a demo store, so no payment was taken and nothing will ship. A confirmation would normally arrive by email within minutes.</p>
      <a href="/products/" class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-white transition hover:bg-ink-soft">Continue shopping</a>
    </div>

    <!-- Checkout flow -->
    <div id="checkout-flow" class="mt-8 grid gap-10 lg:grid-cols-[1fr_380px]">
      <div>
        <!-- Step indicator -->
        <ol id="step-indicator" class="flex items-center gap-2 text-xs font-medium">
          <li data-step-ind="1" class="flex items-center gap-2 rounded-full bg-ink px-3 py-1.5 text-white">1 · Shipping</li>
          <li data-step-ind="2" class="flex items-center gap-2 rounded-full bg-ink/10 px-3 py-1.5 text-ink-soft">2 · Payment</li>
          <li data-step-ind="3" class="flex items-center gap-2 rounded-full bg-ink/10 px-3 py-1.5 text-ink-soft">3 · Done</li>
        </ol>

        <!-- Step 1: shipping -->
        <form id="step-1" class="mt-6" novalidate>
          <h2 class="text-lg font-semibold tracking-tight">Contact &amp; shipping</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">Email</span>
              <input name="email" type="email" required placeholder="you@example.com" autocomplete="email" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">Full name</span>
              <input name="name" type="text" required placeholder="Asha Verma" autocomplete="name" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-medium text-ink-soft">Street address</span>
              <input name="address" type="text" required placeholder="Flat 4, Rose Apartments, Linking Road" autocomplete="street-address" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">City</span>
              <input name="city" type="text" required placeholder="Mumbai" autocomplete="address-level2" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">PIN code</span>
              <input name="pincode" type="text" required inputmode="numeric" placeholder="400050" autocomplete="postal-code" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
          </div>
          <button type="submit" class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-white transition hover:bg-ink-soft">Continue to payment</button>
        </form>

        <!-- Step 2: payment -->
        <form id="step-2" class="mt-6 hidden" novalidate>
          <h2 class="text-lg font-semibold tracking-tight">Payment <span class="text-sm font-normal text-grey">(mock — nothing is charged)</span></h2>
          <fieldset class="mt-4 space-y-3">
            <legend class="sr-only">Payment method</legend>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-white px-4 py-3.5 ring-1 ring-black/10 has-checked:ring-2 has-checked:ring-ink">
              <input type="radio" name="pay" value="card" checked class="accent-black" />
              <span class="text-sm font-medium">Card <span class="font-normal text-grey">— demo fields, never sent anywhere</span></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-white px-4 py-3.5 ring-1 ring-black/10 has-checked:ring-2 has-checked:ring-ink">
              <input type="radio" name="pay" value="upi" class="accent-black" />
              <span class="text-sm font-medium">UPI <span class="font-normal text-grey">— mock</span></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-white px-4 py-3.5 ring-1 ring-black/10 has-checked:ring-2 has-checked:ring-ink">
              <input type="radio" name="pay" value="cod" class="accent-black" />
              <span class="text-sm font-medium">Cash on delivery <span class="font-normal text-grey">— mock</span></span>
            </label>
          </fieldset>
          <div id="card-fields" class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="text-xs font-medium text-ink-soft">Card number (demo — use 4242 4242 4242 4242)</span>
              <input name="card" type="text" inputmode="numeric" placeholder="4242 4242 4242 4242" autocomplete="off" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">Expiry</span>
              <input name="expiry" type="text" placeholder="12 / 28" autocomplete="off" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-ink-soft">CVC</span>
              <input name="cvc" type="text" inputmode="numeric" placeholder="123" autocomplete="off" class="mt-1 w-full rounded-xl bg-white px-4 py-3 text-sm outline-none ring-1 ring-black/10 focus:ring-ink/40" />
            </label>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button type="button" id="back-to-shipping" class="rounded-full bg-white px-6 py-3.5 text-sm font-medium ring-1 ring-black/10 transition hover:bg-mist-2">Back</button>
            <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-white transition hover:bg-ink-soft">Place mock order</button>
          </div>
        </form>
      </div>

      <!-- Order summary -->
      <aside class="h-fit rounded-2xl bg-card p-5 lg:sticky lg:top-28">
        <h2 class="text-base font-semibold tracking-tight">Order summary</h2>
        <ul id="summary-lines" class="mt-4 space-y-3"></ul>
        <dl class="mt-4 space-y-2 border-t border-line pt-4 text-sm">
          <div class="flex justify-between"><dt class="text-grey">Subtotal</dt><dd id="summary-subtotal" class="font-medium">$0</dd></div>
          <div class="flex justify-between"><dt class="text-grey">Shipping</dt><dd id="summary-shipping" class="font-medium">—</dd></div>
          <div class="flex justify-between border-t border-line pt-2 text-base"><dt class="font-semibold">Total</dt><dd id="summary-total" class="font-semibold">$0</dd></div>
        </dl>
        <p class="mt-3 text-[11px] leading-relaxed text-grey">Free shipping over $150. 30-day returns and a 2-year warranty on every product.</p>
      </aside>
    </div>
  </section>

  <script>
    import { getResolvedLines, getSubtotal, clearCart, FREE_SHIPPING_THRESHOLD } from '../scripts/cart';
    import { formatPrice } from '../data/site';

    const lines = getResolvedLines();
    const emptyEl = document.getElementById('checkout-empty');
    const flowEl = document.getElementById('checkout-flow');
    const successEl = document.getElementById('checkout-success');

    if (lines.length === 0) {
      emptyEl?.classList.remove('hidden');
      flowEl?.classList.add('hidden');
    } else {
      // Order summary.
      const listEl = document.getElementById('summary-lines');
      if (listEl) {
        listEl.innerHTML = lines
          .map(
            (l) => `
            <li class="flex items-center gap-3">
              <img src="/images/${l.img}-640.jpg" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-lg bg-white object-cover" loading="lazy" decoding="async" />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium">${l.name}</span>
                <span class="block text-xs text-grey">${l.color} · Qty ${l.qty}</span>
              </span>
              <span class="text-sm font-medium">${formatPrice(l.lineTotal)}</span>
            </li>`,
          )
          .join('');
      }
      const subtotal = getSubtotal();
      const shipping = subtotal >= FREE_SHIPPING_THRESHOLD ? 0 : 9;
      const setText = (id: string, v: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = v;
      };
      setText('summary-subtotal', formatPrice(subtotal));
      setText('summary-shipping', shipping === 0 ? 'Free' : formatPrice(shipping));
      setText('summary-total', formatPrice(subtotal + shipping));

      // Steps.
      const step1 = document.getElementById('step-1') as HTMLFormElement | null;
      const step2 = document.getElementById('step-2') as HTMLFormElement | null;
      const ind = (n: number) => {
        document.querySelectorAll('[data-step-ind]').forEach((el) => {
          const step = Number((el as HTMLElement).dataset.stepInd);
          const active = step <= n;
          el.className = `flex items-center gap-2 rounded-full px-3 py-1.5 ${active ? 'bg-ink text-white' : 'bg-ink/10 text-ink-soft'}`;
        });
      };
      step1?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!step1.checkValidity()) {
          step1.reportValidity();
          return;
        }
        step1.classList.add('hidden');
        step2?.classList.remove('hidden');
        ind(2);
        step2?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      document.getElementById('back-to-shipping')?.addEventListener('click', () => {
        step2?.classList.add('hidden');
        step1?.classList.remove('hidden');
        ind(1);
      });
      document.querySelectorAll('input[name="pay"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          const cardFields = document.getElementById('card-fields');
          const val = (document.querySelector('input[name="pay"]:checked') as HTMLInputElement)?.value;
          cardFields?.classList.toggle('hidden', val !== 'card');
        });
      });
      step2?.addEventListener('submit', (e) => {
        e.preventDefault();
        const pay = (document.querySelector('input[name="pay"]:checked') as HTMLInputElement)?.value;
        if (pay === 'card') {
          const card = (step2.querySelector('input[name="card"]') as HTMLInputElement)?.value.trim();
          if (!card) {
            (step2.querySelector('input[name="card"]') as HTMLInputElement)?.focus();
            return;
          }
        }
        const orderNo = `AUR-${Math.floor(100000 + Math.random() * 900000)}`;
        const orderEl = document.getElementById('order-number');
        if (orderEl) orderEl.textContent = orderNo;
        clearCart();
        flowEl?.classList.add('hidden');
        successEl?.classList.remove('hidden');
        ind(3);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</Layout>
