---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Stars from '../../components/Stars.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, reviews, faqs, formatPrice, site, type Product } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;

const isHero = p.gallery[0] === 'hero-headphones';
const galleryWidths = isHero ? [640, 800, 992] : [640, 800, 1280];
const productReviews = reviews.filter((r) => r.product === p.slug);
const shownReviews = productReviews.slice(0, 3);
const dist = [5, 4, 3, 2, 1].map((stars) => ({
  stars,
  count: productReviews.filter((r) => r.rating === stars).length,
}));
const miniFaqs = faqs.slice(0, 3);
const related = [
  ...products.filter((x) => x.category === p.category && x.slug !== p.slug),
  ...products.filter((x) => x.category !== p.category && x.slug !== p.slug),
].slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    image: `${site.url}/images/${p.img}-800.jpg`,
    description: p.description,
    brand: { '@type': 'Brand', name: 'AURA' },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: String(p.rating),
      reviewCount: String(p.reviewsCount),
    },
    offers: {
      '@type': 'Offer',
      price: String(p.price),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Shop', item: `${site.url}/products/` },
      { '@type': 'ListItem', position: 3, name: p.name },
    ],
  },
];
---
<Layout title={`${p.name} — AURA`} description={p.description} jsonLd={jsonLd}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Shop', href: '/products/' },
      { label: p.name },
    ]}
  />

  <section data-pdp-slug={p.slug} class="mx-auto max-w-6xl px-4 pb-12 pt-6 sm:px-6" aria-labelledby="pdp-heading">
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <!-- Gallery — click (or Enter) opens the lightbox viewer -->
      <div>
        <div id="pdp-gallery" data-widths={galleryWidths.join(',')} data-lightbox-open tabindex="0" role="button" aria-label={`${p.name} — open larger image`} class="cursor-zoom-in overflow-hidden rounded-2xl bg-card">
          <Picture
            name={p.gallery[0]}
            alt={p.alt}
            widths={galleryWidths}
            sizes="(max-width: 768px) 100vw, 560px"
            ratio="aspect-square"
            width={isHero ? 992 : 1920}
            height={isHero ? 1236 : 1280}
            eager
          />
        </div>
        {p.gallery.length > 1 && (
          <div class="mt-3 flex gap-2" role="group" aria-label="Product images">
            {p.gallery.map((name, i) => (
              <button
                type="button"
                data-gallery-thumb={name}
                aria-label={`${p.name} — view ${i + 1}`}
                class="overflow-hidden rounded-xl bg-card ring-offset-2 ring-offset-mist transition hover:opacity-80"
              >
                <img
                  src={`/images/${name}-640.jpg`}
                  alt={`${p.name} — view ${i + 1}`}
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                  class="h-[72px] w-[72px] object-cover"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Buy box -->
      <div id="pdp-buybox">
        {p.badge && (
          <span class="inline-block rounded-full bg-white px-2.5 py-1 text-[11px] font-medium ring-1 ring-black/5">
            {p.badge}
          </span>
        )}
        <h1 id="pdp-heading" class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl">{p.name}</h1>
        <p class="mt-2 text-sm text-grey">{p.tagline}</p>
        <div class="mt-3 flex items-center gap-2">
          <Stars rating={p.rating} reviewsCount={p.reviewsCount} showCount />
          <a href="#reviews" class="text-xs text-grey underline-offset-2 transition hover:text-ink hover:underline">
            {p.reviewsCount} reviews
          </a>
        </div>
        <p class="mt-4 text-2xl font-medium">
          {formatPrice(p.price)}
          {p.compareAt && (
            <span class="ml-2 text-base font-normal text-grey line-through">{formatPrice(p.compareAt)}</span>
          )}
          {p.compareAt && (
            <span class="ml-2 rounded-full bg-ink px-2.5 py-1 align-middle text-[11px] font-medium text-white">
              Save {formatPrice(p.compareAt - p.price)}
            </span>
          )}
        </p>
        <!-- Stock + delivery estimate (estimate is a mock, computed client-side) -->
        <p class="mt-3 flex items-center gap-2 text-xs font-medium">
          <span class={`h-2 w-2 shrink-0 rounded-full ${p.lowStock ? 'bg-amber-500' : 'bg-green-600'}`} aria-hidden="true"></span>
          {p.stock}
        </p>
        <p id="delivery-estimate" class="mt-1 text-xs text-grey">Free delivery · arrives in 3–5 business days</p>
        <p class="mt-4 text-sm leading-relaxed text-grey">{p.description}</p>

        <!-- Colour -->
        <div class="mt-6">
          <p class="text-sm font-medium">
            Colour: <span id="selected-color-name" class="font-normal text-grey">{p.colors[0]}</span>
          </p>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Choose a colour">
            {p.colors.map((c, i) => (
              <button
                type="button"
                data-color-btn={c}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="min-h-11 rounded-full px-4 py-2.5 text-xs font-medium ring-1 ring-black/10 transition hover:ring-ink aria-pressed:bg-ink aria-pressed:text-white aria-pressed:ring-ink"
              >
                {c}
              </button>
            ))}
          </div>
        </div>

        <!-- Quantity -->
        <div class="mt-6">
          <p class="text-sm font-medium">Quantity</p>
          <div class="mt-2 inline-flex items-center rounded-full ring-1 ring-black/10">
            <button type="button" data-qty-dec aria-label="Decrease quantity" class="grid h-11 w-11 place-items-center rounded-full text-lg transition hover:bg-ink/5">−</button>
            <span id="pdp-qty" class="w-8 text-center text-sm font-medium">1</span>
            <button type="button" data-qty-inc aria-label="Increase quantity" class="grid h-11 w-11 place-items-center rounded-full text-lg transition hover:bg-ink/5">+</button>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row">
          <button
            type="button"
            data-add-to-bag={p.slug}
            class="w-full rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-white transition hover:bg-ink-soft sm:w-auto"
          >
            Add to bag — {formatPrice(p.price)}
          </button>
          <button
            type="button"
            data-buy-now={p.slug}
            class="w-full rounded-full bg-white px-6 py-3.5 text-sm font-medium ring-1 ring-black/10 transition hover:ring-ink sm:w-auto"
          >
            Buy now
          </button>
          <button
            type="button"
            data-wishlist-toggle={p.slug}
            aria-pressed="false"
            aria-label={`Save ${p.name} to wishlist`}
            class="grid h-11 w-11 shrink-0 place-items-center self-center rounded-full bg-white ring-1 ring-black/10 transition hover:ring-ink"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
          </button>
        </div>

        <!-- Trust row -->
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-grey">
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h13v10H3zM16 10h4l1 3v4h-5z"/><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="2"/></svg>
            Free shipping over $150
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
            30-day returns
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
            2-year warranty
          </li>
        </ul>
      </div>
    </div>

    <!-- Specs + features -->
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-medium tracking-tight">Specifications</h2>
        <dl class="mt-4">
          {[
            ['Driver', p.specs.driver],
            ['Battery life', p.specs.battery],
            ['Noise cancelling', p.specs.anc],
            ['Bluetooth', p.specs.bluetooth],
            ['Weight', p.specs.weight],
            ['Charging', p.specs.charging],
          ].map(([label, value]) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-black/5 py-3">
              <dt class="text-sm text-grey">{label}</dt>
              <dd class="text-right text-sm font-medium">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="text-xl font-medium tracking-tight">What makes it great</h2>
        <ul class="mt-4 space-y-3">
          {p.features.map((f) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- What's in the box -->
    <section class="mt-12" aria-labelledby="inbox-heading">
      <h2 id="inbox-heading" class="text-xl font-medium tracking-tight">What's in the box</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {p.inBox.map((item) => (
          <li class="flex items-start gap-2.5 rounded-2xl bg-card px-4 py-3 text-sm leading-relaxed">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="mt-12" aria-labelledby="reviews-heading">
      <h2 id="reviews-heading" class="text-xl font-medium tracking-tight">Reviews</h2>
      {productReviews.length === 0 ? (
        <p class="mt-4 text-sm text-grey">No reviews yet.</p>
      ) : (
        <div class="mt-4 grid gap-8 md:grid-cols-[240px_1fr]">
          <div>
            <p class="text-4xl font-medium">{p.rating.toFixed(1)}</p>
            <div class="mt-2"><Stars rating={p.rating} /></div>
            <p class="mt-1 text-xs text-grey">Based on {p.reviewsCount} reviews</p>
            <div class="mt-4 space-y-2">
              {dist.map(({ stars, count }) => {
                const pct = productReviews.length > 0 ? Math.round((count / productReviews.length) * 100) : 0;
                return (
                  <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 text-right font-medium">{stars}</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 5.9 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3 1.2-6.5L2.5 9.3l6.6-.9L12 2.5Z"/></svg>
                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-black/5">
                      <div class="h-full rounded-full bg-ink" style={`width: ${pct}%`}></div>
                    </div>
                    <span class="w-8 text-grey">{count}</span>
                  </div>
                );
              })}
            </div>
          </div>
          <div class="space-y-3">
            {shownReviews.map((r) => (
              <article class="rounded-2xl bg-card p-4 sm:p-5">
                <Stars rating={r.rating} />
                <h3 class="mt-2 text-sm font-medium">{r.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-grey">{r.body}</p>
                <p class="mt-3 text-xs text-grey">{r.name} · {r.date}</p>
              </article>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Mini FAQ -->
    <section class="mt-12" aria-labelledby="pdp-faq-heading">
      <h2 id="pdp-faq-heading" class="text-xl font-medium tracking-tight">Questions, answered</h2>
      <div data-accordion-group class="mt-4 divide-y divide-black/5 rounded-2xl bg-card px-4 sm:px-5">
        {miniFaqs.map((f, i) => (
          <div data-accordion-item data-open={i === 0 ? '' : undefined}>
            <button
              type="button"
              data-accordion-btn
              aria-expanded={i === 0 ? 'true' : 'false'}
              class="flex w-full items-center justify-between gap-4 py-4 text-left text-sm font-medium"
            >
              {f.q}
              <svg data-accordion-chevron width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div data-accordion-panel>
              <p class="pb-4 text-sm leading-relaxed text-grey">{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related -->
    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-xl font-medium tracking-tight">You may also like</h2>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {related.map((r) => (
          <ProductCard product={r} />
        ))}
      </div>
    </section>

    <!-- Recently viewed — filled client-side from localStorage -->
    <section data-recently-viewed class="mt-12 hidden" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="text-xl font-medium tracking-tight">Recently viewed</h2>
      <div data-recently-viewed-list class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"></div>
    </section>
  </section>

  <!-- Gallery lightbox — hidden until the main image is clicked -->
  <div id="pdp-lightbox" class="fixed inset-0 z-[98] hidden items-center justify-center bg-ink/80 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Product image viewer">
    <button type="button" data-lightbox-close aria-label="Close image viewer" class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full bg-white text-ink transition hover:bg-mist">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <img id="pdp-lightbox-img" src={`/images/${p.gallery[0]}-800.jpg`} alt={p.alt} class="max-h-[85vh] max-w-full rounded-2xl object-contain" />
  </div>

  <!-- Mobile sticky buy bar — shown after scrolling past the buy box -->
  <div id="pdp-sticky-bar" class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 md:hidden" role="region" aria-label="Buy bar">
    <div class="flex items-center gap-3 border-t border-line bg-white/95 px-4 pb-[env(safe-area-inset-bottom)] pt-3 backdrop-blur-md">
      <img src={`/images/${p.img}-640.jpg`} alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-xl bg-card object-cover" loading="lazy" decoding="async" />
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium">{p.name}</p>
        <p class="text-xs text-grey">{formatPrice(p.price)}</p>
      </div>
      <button type="button" data-add-to-bag={p.slug} class="shrink-0 rounded-full bg-ink px-5 py-3 text-sm font-medium text-white transition hover:bg-ink-soft">Add to bag</button>
    </div>
  </div>
</Layout>
