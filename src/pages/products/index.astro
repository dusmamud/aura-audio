---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories } from '../../data/site';

const filters = ['All', ...categories];
---
<Layout
  title="Shop — AURA"
  description="Shop all AURA products — over-ear headphones, wireless earbuds, smartwatch, portable speaker, home speaker and accessories. Free shipping over $150."
>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-24 sm:px-6 sm:pt-28" aria-labelledby="shop-heading">
    <h1 id="shop-heading" class="text-3xl font-medium tracking-tight sm:text-4xl">Shop all products.</h1>
    <p class="mt-2 text-sm text-grey">Every product, one place. Filter by category, sort, or search.</p>

    <!-- Controls -->
    <div class="mt-6 flex flex-col gap-3">
      <div class="no-scrollbar flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter by category">
        {filters.map((f) => (
          <button
            type="button"
            data-filter={f}
            class="shrink-0 rounded-full px-4 py-2 text-[13px] font-medium ring-1 ring-black/5 transition hover:ring-ink"
          >
            {f}
          </button>
        ))}
      </div>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <label class="sr-only" for="sort-select">Sort products</label>
        <select
          id="sort-select"
          class="rounded-full bg-white px-4 py-2.5 text-[13px] font-medium ring-1 ring-black/5"
        >
          <option value="featured">Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="rating">Top Rated</option>
          <option value="newest">Newest</option>
        </select>
        <label class="sr-only" for="shop-search">Search products</label>
        <input
          id="shop-search"
          type="search"
          placeholder="Search products…"
          class="flex-1 rounded-full bg-white px-4 py-2.5 text-[13px] ring-1 ring-black/5 placeholder:text-grey focus:outline-none"
        />
      </div>
    </div>

    <p id="shop-count" class="mt-6 text-xs text-grey" aria-live="polite"></p>

    <div id="shop-grid" class="mt-3 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {products.map((p, i) => (
        <div
          data-name={`${p.name} ${p.category}`.toLowerCase()}
          data-price={p.price}
          data-rating={p.rating}
          data-category={p.category}
          data-index={i}
        >
          <ProductCard product={p} />
        </div>
      ))}
    </div>

    <div id="shop-empty" class="hidden rounded-2xl bg-card px-6 py-12 text-center">
      <p class="text-sm font-medium">No products match — try a different search or category.</p>
    </div>

    <!-- Recently viewed — filled client-side from localStorage -->
    <section data-recently-viewed class="mt-12 hidden" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="text-xl font-medium tracking-tight">Recently viewed</h2>
      <div data-recently-viewed-list class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"></div>
    </section>
  </section>
</Layout>

<script>
  const grid = document.getElementById('shop-grid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-name]')) : [];
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('shop-search') as HTMLInputElement | null;
  const countEl = document.getElementById('shop-count');
  const emptyEl = document.getElementById('shop-empty');

  const params = new URLSearchParams(window.location.search);
  let activeCategory = params.get('category') || 'All';
  if (activeCategory !== 'All' && !cards.some((c) => c.dataset.category === activeCategory)) {
    activeCategory = 'All';
  }

  function setPills() {
    pills.forEach((pill) => {
      const active = pill.dataset.filter === activeCategory;
      pill.classList.toggle('bg-ink', active);
      pill.classList.toggle('text-white', active);
      pill.classList.toggle('bg-white', !active);
      pill.setAttribute('aria-pressed', String(active));
    });
  }

  function apply() {
    if (!grid || !sortSelect || !searchInput) return;
    const q = (searchInput.value || '').trim().toLowerCase();
    const sort = sortSelect.value;
    const ordered = [...cards];
    if (sort === 'price-asc') {
      ordered.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
    } else if (sort === 'price-desc') {
      ordered.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
    } else if (sort === 'rating') {
      ordered.sort((a, b) => Number(b.dataset.rating) - Number(a.dataset.rating));
    } else if (sort === 'newest') {
      ordered.sort((a, b) => Number(b.dataset.index) - Number(a.dataset.index));
    } else {
      ordered.sort((a, b) => Number(a.dataset.index) - Number(b.dataset.index));
    }
    let visible = 0;
    ordered.forEach((card) => {
      grid.appendChild(card);
      const matchesCategory = activeCategory === 'All' || card.dataset.category === activeCategory;
      const matchesQuery = !q || (card.dataset.name || '').includes(q);
      const show = matchesCategory && matchesQuery;
      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });
    if (countEl) {
      countEl.textContent = visible === 1 ? '1 product' : `${visible} products`;
    }
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
    setPills();
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCategory = pill.dataset.filter || 'All';
      const url = new URL(window.location.href);
      if (activeCategory === 'All') url.searchParams.delete('category');
      else url.searchParams.set('category', activeCategory);
      window.history.replaceState(null, '', url);
      apply();
    });
  });
  sortSelect?.addEventListener('change', apply);
  searchInput?.addEventListener('input', apply);
  apply();
</script>
