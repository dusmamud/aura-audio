---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — AURA" description="This page does not exist.">
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-36 text-center sm:px-6">
    <p class="text-sm font-medium uppercase tracking-widest text-grey">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">This page is off the record.</h1>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-grey">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-ink-soft">Back to home</a>
  </section>
</Layout>
