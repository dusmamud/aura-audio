---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { faqs, articles } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const cards = [
  {
    id: 'shipping',
    title: 'Shipping',
    body: '2–5 business days in India, 5–10 business days worldwide. Free shipping on all orders over $150 — otherwise a flat $9 at checkout.',
  },
  {
    id: 'returns',
    title: 'Returns',
    body: '30 days, full refund, no questions asked. Send the product back in its original condition and we will email you a prepaid return label.',
  },
  {
    id: 'warranty',
    title: 'Warranty',
    body: '2 years on every product, covering manufacturing defects and battery faults. Accidental damage is not covered, but we will always offer a fair repair price first.',
  },
];
---
<Layout
  title="Support — AURA"
  description="How can we help? Shipping, returns and warranty information, answers to frequently asked questions, and how to contact AURA support."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Support' }]} />

  <!-- HERO -->
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10" aria-labelledby="support-heading">
    <div class="reveal">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-grey">Support</p>
      <h1 id="support-heading" class="mt-4 max-w-2xl text-4xl font-medium leading-[1.05] tracking-[-0.03em] sm:text-6xl">
        How can we help?
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-grey">
        Shipping, returns, warranty — and answers to the questions we hear most.
        If you cannot find what you need, write to us below.
      </p>
    </div>
  </section>

  <!-- INFO CARDS -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-label="Shipping, returns and warranty">
    <div class="grid gap-4 md:grid-cols-3">
      {cards.map((c) => (
        <article id={c.id} class="reveal scroll-mt-28 rounded-2xl bg-card p-6 sm:p-8">
          <h2 class="text-lg font-semibold tracking-tight">{c.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-grey">{c.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ ACCORDION -->
  <section id="faq" class="mx-auto max-w-6xl scroll-mt-28 px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="faq-heading">
    <div class="reveal">
      <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">Frequently asked questions</h2>
      <div data-accordion-group class="mt-6 overflow-hidden rounded-2xl bg-card">
        {faqs.map((f, i) => (
          <div data-accordion-item={true} data-open={i === 0 ? true : undefined} class={i > 0 ? 'border-t border-black/5' : ''}>
            <h3>
              <button
                type="button"
                data-accordion-btn
                aria-expanded={i === 0 ? 'true' : 'false'}
                class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition hover:bg-black/[0.02] sm:px-6"
              >
                <span class="flex flex-wrap items-center gap-2 text-sm font-medium sm:text-base">
                  {f.q}
                  <span class="rounded-full bg-white px-2.5 py-0.5 text-[11px] font-medium text-grey ring-1 ring-black/5">{f.tag}</span>
                </span>
                <svg data-accordion-chevron width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-grey" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            </h3>
            <div data-accordion-panel>
              <p class="px-5 pb-5 text-sm leading-relaxed text-grey sm:px-6">{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-6xl scroll-mt-28 px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="contact-heading">
    <div class="reveal grid gap-6 md:grid-cols-2 md:gap-10">
      <div>
        <h2 id="contact-heading" class="text-2xl font-semibold tracking-tight">Contact us</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-grey">
          Tell us what you need and we will reply within one business day.
          You can also write to us directly at hello@aura.audio.
        </p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-grey">
          Support hours: Mon–Sat, 10am–7pm IST.
        </p>
      </div>
      <div>
        <form id="contact-form" novalidate class="rounded-2xl bg-card p-6 sm:p-8">
          <div>
            <label for="contact-name" class="text-sm font-medium">Name</label>
            <input id="contact-name" name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-full bg-white px-4 py-3 text-sm text-ink ring-1 ring-black/5 outline-none transition focus:ring-2 focus:ring-ink" />
          </div>
          <div class="mt-4">
            <label for="contact-email" class="text-sm font-medium">Email</label>
            <input id="contact-email" name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-full bg-white px-4 py-3 text-sm text-ink ring-1 ring-black/5 outline-none transition focus:ring-2 focus:ring-ink" />
          </div>
          <div class="mt-4">
            <label for="contact-message" class="text-sm font-medium">Message</label>
            <textarea id="contact-message" name="message" rows="5" required class="mt-2 w-full resize-y rounded-2xl bg-white px-4 py-3 text-sm text-ink ring-1 ring-black/5 outline-none transition focus:ring-2 focus:ring-ink"></textarea>
          </div>
          <button type="submit" class="mt-6 inline-flex items-center gap-3 rounded-full bg-ink px-5 py-3 text-[13px] font-medium text-white transition hover:opacity-90">
            Send message
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </button>
        </form>
        <div id="contact-success" class="hidden rounded-2xl bg-card p-6 sm:p-8" role="status">
          <p class="text-base font-medium">Thanks — your message is on its way. We reply within one business day. (Demo: no message was sent.)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-2 sm:px-6" aria-labelledby="guides-heading">
    <div class="reveal rounded-2xl bg-card p-6 sm:p-8">
      <h2 id="guides-heading" class="text-lg font-semibold tracking-tight">Guides &amp; reading</h2>
      <ul class="mt-4 space-y-3">
        {articles.map((a) => (
          <li>
            <a href={`/journal/${a.slug}/`} class="text-sm font-medium underline decoration-black/20 underline-offset-4 transition hover:text-grey">{a.title}</a>
          </li>
        ))}
        <li>
          <a href="/technology/" class="text-sm font-medium underline decoration-black/20 underline-offset-4 transition hover:text-grey">Technology — how AURA One works</a>
        </li>
      </ul>
    </div>
  </section>

  <script>
    // Inline validation helper from motion.ts — resolved at CALL time, not
    // at module-eval time (see checkout.astro: this page's module can
    // evaluate before Layout's motion.ts module sets window.__auraValidate).
    type ValidateFn = (
      form: HTMLFormElement,
      rules?: Record<string, { test: (v: string) => boolean; message: string }>,
      afterForm?: boolean,
    ) => boolean;
    const getValidateForm = () =>
      (window as unknown as { __auraValidate?: ValidateFn }).__auraValidate;
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      // Inline errors under each invalid field; the form carries novalidate
      // so the native bubble never appears.
      const validateForm = getValidateForm();
      if (validateForm) {
        if (!validateForm(form)) return;
      } else if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.classList.add('hidden');
      document.getElementById('contact-success')?.classList.remove('hidden');
    });
  </script>
</Layout>
