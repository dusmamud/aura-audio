---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import ProductCard from '../components/ProductCard.astro';
import Stars from '../components/Stars.astro';
import { site, features, products, testimonials, community, categories, formatPrice } from '../data/site';

const bestsellers = [...products]
  .sort((a, b) => b.rating - a.rating || b.reviewsCount - a.reviewsCount)
  .slice(0, 4);

// Shop-by-category tiles reuse existing product images — no new assets.
const categoryTiles = categories.map((c) => {
  const first = products.find((p) => p.category === c);
  return { category: c, img: first?.img ?? 'hero-headphones', alt: first?.alt ?? c, count: products.filter((p) => p.category === c).length };
});

const marqueeItems = [
  'Free shipping over $150',
  '30-day returns',
  '2-year warranty',
  'Secure checkout',
  'Crafted for focus',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AURA products',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      image: `${site.url}/images/${p.img}-800.jpg`,
      offers: { '@type': 'Offer', price: String(p.price), priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    },
  })),
};
---
<Layout
  title="AURA — Crafted for Focus. Designed for Life."
  description="AURA is a premium audio brand. Over-ear headphones, wireless earbuds, smartwatch, portable speaker and charging dock — crafted for focus, designed for life."
  jsonLd={jsonLd}
>
  <!-- HERO — transparent cutout, no card: the headphones sit directly on
       the page background like the reference. Mobile-first order is
       headline → image → CTA (the wrapper is `contents` on mobile so its
       children become grid items; on md it is the left column again). -->
  <section class="mx-auto max-w-6xl px-4 pb-10 pt-24 sm:px-6 sm:pt-32" aria-labelledby="hero-heading">
    <div class="grid gap-6 md:grid-cols-[1.05fr_1fr] md:items-center md:gap-6">
      <div class="contents md:block">
        <h1 data-hero id="hero-heading" class="order-1 text-[2.9rem] font-medium leading-[1.04] tracking-[-0.03em] sm:text-6xl lg:text-[4.4rem]">
          Crafted<br />for Focus.<br /><span class="text-[#a9a9a4]">Designed<br />for Life.</span>
        </h1>
        <a data-hero href="#products" class="order-3 mt-0 inline-flex items-center gap-3 justify-self-start self-start rounded-full bg-white px-5 py-3 text-[13px] font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.06),0_8px_24px_rgba(0,0,0,0.06)] ring-1 ring-black/5 transition hover:bg-ink hover:text-white md:mt-7">
          Explore the Experience
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      </div>
      <div data-hero data-parallax class="relative order-2 mx-auto w-full max-w-[320px] md:max-w-[440px]">
        <div class="hero-shadow absolute bottom-1 left-1/2 h-8 w-3/4 -translate-x-1/2" aria-hidden="true"></div>
        <Picture
          name="hero-headphones"
          alt="Silver AURA over-ear headphones"
          widths={[640, 800, 992]}
          sizes="(max-width: 768px) 320px, 440px"
          width={992}
          height={1236}
          imgClass="cutout relative h-auto"
          eager
        />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="mx-auto max-w-6xl px-4 pb-2 pt-2 sm:px-6" aria-label="Shopping benefits">
    <div class="reveal grid grid-cols-2 gap-3 rounded-2xl bg-card px-4 py-5 sm:grid-cols-4 sm:px-6">
      <div class="flex items-center gap-2.5 text-[13px] font-medium">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M3 7h13v10H3zM16 10h4l1 3v4h-5z"/><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="2"/></svg>
        Free shipping over $150
      </div>
      <div class="flex items-center gap-2.5 text-[13px] font-medium">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
        30-day returns
      </div>
      <div class="flex items-center gap-2.5 text-[13px] font-medium">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
        2-year warranty
      </div>
      <div class="flex items-center gap-2.5 text-[13px] font-medium">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        Secure checkout
      </div>
    </div>
  </section>

  <!-- 01 / 02 / 03 -->
  {features.map((f, i) => (
    <section id={f.id} class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8" aria-labelledby={`feature-${f.num}`}>
      <div class="reveal grid items-center gap-6 md:grid-cols-2 md:gap-10">
        <div class={i % 2 === 0 ? 'md:order-1' : 'md:order-2'}>
          <div class="overflow-hidden rounded-2xl bg-card">
            <Picture
              name={f.img}
              alt={f.alt}
              sizes="(max-width: 768px) 100vw, 560px"
              ratio={f.ratio}
            />
          </div>
        </div>
        <div class={i % 2 === 0 ? 'md:order-2' : 'md:order-1'}>
          <p class="text-[2rem] font-light leading-none tracking-tight" aria-hidden="true">{f.num}</p>
          <h2 id={`feature-${f.num}`} class="mt-4 whitespace-pre-line text-2xl font-semibold leading-snug tracking-tight">{f.title}</h2>
          <p class="mt-3 max-w-[300px] text-sm leading-relaxed text-grey">{f.body}</p>
        </div>
      </div>
    </section>
  ))}

  <!-- SHOP BY CATEGORY -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="categories-heading">
    <div class="reveal">
      <h2 id="categories-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">Shop by category.</h2>
      <p class="mt-1 text-sm text-grey">Find the sound that fits your day.</p>
    </div>
    <div class="mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 no-scrollbar sm:grid sm:grid-cols-5 sm:overflow-visible sm:pb-0">
      {categoryTiles.map((t) => (
        <a href={`/products/?category=${t.category}`} class="group w-[160px] shrink-0 snap-start sm:w-auto">
          <div class="overflow-hidden rounded-2xl bg-card">
            <Picture
              name={t.img}
              alt={t.alt}
              widths={[640]}
              sizes="(max-width: 768px) 160px, 220px"
              ratio="aspect-square"
            />
          </div>
          <p class="mt-3 text-sm font-medium transition group-hover:underline">{t.category}</p>
          <p class="text-xs text-grey">{t.count} {t.count === 1 ? 'product' : 'products'}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="products-heading">
    <h2 id="products-heading" class="sr-only">Products</h2>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {products.map((p) => (
        <article class="product-card reveal rounded-2xl bg-card p-3 sm:p-4">
          <div class="overflow-hidden rounded-xl">
            <Picture
              name={p.img}
              alt={p.alt}
              widths={[640, 800]}
              sizes="(max-width: 768px) 50vw, 280px"
              ratio="aspect-square"
            />
          </div>
          <h3 class="mt-3 text-center text-xs font-medium sm:text-sm">{p.name}</h3>
          <p class="mt-0.5 text-center text-xs text-grey sm:text-sm">{formatPrice(p.price)}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- BESTSELLERS -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="bestsellers-heading">
    <div class="reveal flex items-end justify-between gap-4">
      <div>
        <h2 id="bestsellers-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">Bestsellers.</h2>
        <p class="mt-1 text-sm text-grey">The products our listeners reach for most.</p>
      </div>
      <a href="/products/" class="shrink-0 text-[13px] font-medium underline-offset-4 transition hover:text-grey hover:underline">Shop all →</a>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {bestsellers.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="testimonials-heading">
    <div class="reveal flex items-end justify-between gap-4">
      <div>
        <h2 id="testimonials-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">Loved by listeners.</h2>
        <p class="mt-1 text-sm text-grey">Real words from people who live with AURA every day.</p>
      </div>
      <div class="flex shrink-0 gap-2">
        <button type="button" id="testi-prev" aria-label="Previous testimonial" class="grid h-10 w-10 place-items-center rounded-full bg-white ring-1 ring-black/5 transition hover:ring-ink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" id="testi-next" aria-label="Next testimonial" class="grid h-10 w-10 place-items-center rounded-full bg-white ring-1 ring-black/5 transition hover:ring-ink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    <div id="testi-track" class="no-scrollbar mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 sm:gap-4">
      {testimonials.map((t) => (
        <figure class="w-[85%] shrink-0 snap-center rounded-2xl bg-card p-5 sm:w-[420px] sm:p-6">
          <Stars rating={t.rating} />
          <blockquote class="mt-3 text-[15px] leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="mt-4 text-xs text-grey">
            <span class="block text-sm font-medium text-ink">{t.name}</span>
            {t.role}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <script>
    const track = document.getElementById('testi-track');
    const prev = document.getElementById('testi-prev');
    const next = document.getElementById('testi-next');
    function step(dir: number) {
      if (!track) return;
      const card = track.querySelector('figure');
      const w = card ? card.getBoundingClientRect().width + 12 : 320;
      track.scrollBy({ left: dir * w, behavior: 'smooth' });
    }
    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));
  </script>

  <!-- FROM THE COMMUNITY -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10" aria-labelledby="community-heading">
    <div class="reveal">
      <h2 id="community-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">From the community.</h2>
      <p class="mt-1 text-sm text-grey">Listeners, everywhere — in their own words.</p>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-3 sm:gap-4">
      {community.map((c) => (
        <figure class="reveal overflow-hidden rounded-2xl bg-card">
          <div class="overflow-hidden">
            <Picture name={c.img} alt={c.alt} widths={[640, 800]} sizes="(max-width: 768px) 100vw, 360px" ratio="aspect-[4/3]" />
          </div>
          <figcaption class="p-4 sm:p-5">
            <blockquote class="text-sm leading-relaxed">“{c.quote}”</blockquote>
            <p class="mt-3 text-xs font-medium text-grey">{c.handle}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- STORY / CTA BANNER -->
  <section id="story" class="mx-auto max-w-6xl px-4 pb-12 pt-2 sm:px-6" aria-labelledby="story-heading">
    <div class="reveal flex flex-col gap-6 rounded-[1.75rem] bg-[#ececea] px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10 sm:py-12">
      <div>
        <h2 id="story-heading" class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">Sound that Inspires.<br />Design that Lasts.</h2>
        <p class="mt-2 text-sm text-grey">Join the future of premium audio.</p>
      </div>
      <a href="#products" class="inline-flex shrink-0 items-center gap-3 self-start rounded-full bg-white px-5 py-3 text-[13px] font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.06),0_8px_24px_rgba(0,0,0,0.06)] ring-1 ring-black/5 transition hover:bg-ink hover:text-white sm:self-auto">
        Discover More
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee bg-ink py-3 text-white" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {marqueeItems.map((item) => (
            <span class="flex items-center whitespace-nowrap text-[13px] font-medium tracking-wide">
              <span class="px-5">{item}</span>
              <span class="text-white/50">•</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</Layout>
